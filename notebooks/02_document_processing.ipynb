 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 02 Document Processing\n",
    "\n",
    "Test the document chunking and embedding pipeline.\n",
    "\n",
    "This notebook:\n",
    "- Loads documents\n",
    "- Chunks them with metadata preservation\n",
    "- Generates embeddings via OpenAI API\n",
    "- Caches embeddings locally"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "project_root = Path.cwd()\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.config import Config\n",
    "from src.document_loader import DocumentLoader\n",
    "from src.chunker import Chunker\n",
    "from src.embeddings import EmbeddingGenerator\n",
    "from src.logger import get_logger\n",
    "\n",
    "logger = get_logger(__name__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load configuration\n",
    "config = Config()\n",
    "print(f\"Configuration: {config}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load documents\n",
    "loader = DocumentLoader(config.reports_dir)\n",
    "documents = loader.load_all()\n",
    "print(f\"Loaded {len(documents)} documents\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chunk documents\n",
    "chunker = Chunker(chunk_size=1000, chunk_overlap=200)\n",
    "chunks = chunker.chunk_documents(documents)\n",
    "\n",
    "print(f\"\\nChunked into {len(chunks)} chunks\")\n",
    "if chunks:\n",
    "    avg_size = sum(len(c.text) for c in chunks) / len(chunks)\n",
    "    print(f\"Average chunk size: {avg_size:.0f} characters\")\n",
    "    print(f\"\\nFirst chunk:\n  ID: {chunks[0].chunk_id}\")\n",
    "    print(f\"  Text: {chunks[0].text[:200]}...\")\n",
    "    print(f\"  Metadata: {chunks[0].metadata}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate embeddings (requires OPENAI_API_KEY)\n",
    "try:\n",
    "    embedding_gen = EmbeddingGenerator(config)\n",
    "    embeddings = embedding_gen.embed_chunks(\n",
    "        chunks,\n",
    "        cache_path=config.embeddings_cache_path,\n",
    "        force_regenerate=False  # Use cache if available\n",
    "    )\n",
    "    print(f\"Generated embeddings shape: {embeddings.shape}\")\n",
    "except ValueError as e:\n",
    "    print(f\"Error: {e}\")\n",
    "    print(\"Please set OPENAI_API_KEY in .env file\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Verify metadata preservation\n",
    "print(\"\\n=== Metadata Preservation Check ===")\n",
    "for i, chunk in enumerate(chunks[:3]):\n",
    "    print(f\"\\nChunk {i}:\")\n",
    "    print(f\"  Chunk ID: {chunk.chunk_id}\")\n",
    "    print(f\"  Document ID: {chunk.document_id}\")\n",
    "    print(f\"  Title: {chunk.metadata.get('title', 'N/A')}\")\n",
    "    print(f\"  Source File: {chunk.metadata.get('source_file', 'N/A')}\")\n",
    "    print(f\"  Text length: {len(chunk.text)}\")\n",
    "    print(f\"  Text preview: {chunk.text[:100]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Next steps\n",
    "print(\"\\n=== Next Steps ===")\n",
    "print(\"1. Run notebook 03_retrieval_evaluation.ipynb to test retrieval\")\n",
    "print(\"2. Test semantic search quality\")\n",
    "print(\"3. Move to RAG pipeline in notebook 04\")"
   ]
  }
 ],
