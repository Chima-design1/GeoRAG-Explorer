   "source": [
    "# 04 RAG Evaluation\n",
    "\n",
    "Test the complete Retrieval-Augmented Generation pipeline.\n",
    "\n",
    "This notebook:\n",
    "- Tests end-to-end RAG on geological queries\n",
    "- Shows generated answers with source citations\n",
    "- Evaluates grounding quality\n",
    "- Prepares for Phase 6 full evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "project_root = Path.cwd()\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.config import Config\n",
    "from src.document_loader import DocumentLoader\n",
    "from src.chunker import Chunker\n",
    "from src.embeddings import EmbeddingGenerator\n",
    "from src.retriever import VectorRetriever\n",
    "from src.rag import RAG\n",
    "from src.logger import get_logger\n",
    "\n",
    "logger = get_logger(__name__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize RAG pipeline\n",
    "config = Config()\n",
    "loader = DocumentLoader(config.reports_dir)\n",
    "documents = loader.load_all()\n",
    "\n",
    "chunker = Chunker()\n",
    "chunks = chunker.chunk_documents(documents)\n",
    "\n",
    "embedding_gen = EmbeddingGenerator(config)\n",
    "embeddings = embedding_gen.embed_chunks(chunks, cache_path=config.embeddings_cache_path)\n",
    "\n",
    "retriever = VectorRetriever(chunks, embeddings, top_k=5)\n",
    "\n",
    "rag = RAG(retriever, config, embedding_generator=embedding_gen)\n",
    "\n",
    "print(\"RAG pipeline initialized and ready\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test query 1: Mineral occurrence\n",
    "question_1 = \"What minerals are found in Ogun State?\"\n",
    "\n",
    "print(f\"Question: {question_1}\\n\")\n",
    "result_1 = rag.query(question_1, top_k=5)\n",
    "\n",
    "print(f\"Answer:\\n{result_1['answer']}\\n\")\n",
    "print(\"Sources:\")\n",
    "for source in result_1['sources']:\n",
    "    print(f\"  [{source['source_number']}] {source['title']} ({source['source_file']})\")\n",
    "    print(f\"      Score: {source['similarity_score']:.4f}\")\n",
    "    print(f\"      Preview: {source['text_preview']}\\n\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
