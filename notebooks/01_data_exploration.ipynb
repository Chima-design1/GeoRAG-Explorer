   "source": [
    "# 01 Data Exploration\n",
    "\n",
    "Explore the geological reports loaded into the system.\n",
    "\n",
    "This notebook:\n",
    "- Loads reports from `data/reports/`\n",
    "- Displays basic statistics\n",
    "- Shows document summaries\n",
    "- Prepares for chunking analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "# Add project root to path\n",
    "project_root = Path.cwd()\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.config import Config\n",
    "from src.document_loader import DocumentLoader\n",
    "from src.logger import get_logger\n",
    "\n",
    "# Initialize logger\n",
    "logger = get_logger(__name__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load configuration\n",
    "try:\n",
    "    config = Config()\n",
    "    print(f\"Configuration loaded successfully: {config}\")\n",
    "except ValueError as e:\n",
    "    print(f\"Error loading configuration: {e}\")\n",
    "    print(\"Please create a .env file with OPENAI_API_KEY\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load geological reports\n",
    "loader = DocumentLoader(config.reports_dir)\n",
    "documents = loader.load_all()\n",
    "\n",
    "print(f\"\\nLoaded {len(documents)} geological reports\")\n",
    "print(f\"Reports directory: {config.reports_dir}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display document statistics\n",
    "if documents:\n",
    "    print(\"\\n=== Document Statistics ===")\n",
    "    total_chars = sum(len(d.content) for d in documents)\n",
    "    avg_chars = total_chars / len(documents)\n",
    "    \n",
    "    print(f\"Total documents: {len(documents)}\")\n",
    "    print(f\"Total characters: {total_chars:,}\")\n",
    "    print(f\"Average document size: {avg_chars:,.0f} characters\")\n",
    "    print(f\"Largest document: {max(len(d.content) for d in documents):,} characters\")\n",
    "    print(f\"Smallest document: {min(len(d.content) for d in documents):,} characters\")\n",
    "else:\n",
    "    print(\"No documents loaded. Place .txt files in data/reports/\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Display first few documents\n",
    "if documents:\n",
    "    print(\"\\n=== Sample Documents ===")\n",
    "    for doc in documents[:3]:\n",
    "        print(f\"\\nDocument: {doc.title}\")\n",
    "        print(f\"  File: {doc.source_file}\")\n",
    "        print(f\"  Type: {doc.document_type}\")\n",
    "        print(f\"  Size: {len(doc.content):,} characters\")\n",
    "        print(f\"  Preview: {doc.content[:200]}...\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Next steps\n",
    "print(\"\\n=== Next Steps ===")\n",
    "print(\"1. Run notebook 02_document_processing.ipynb to test chunking\")\n",
    "print(\"2. Review chunk sizes and metadata preservation\")\n",
    "print(\"3. Prepare for embedding generation in notebook 02\")"
   ]
  }
 ],
