   "source": [
    "# 03 Retrieval Evaluation\n",
    "\n",
    "Test semantic search and retrieval quality.\n",
    "\n",
    "This notebook:\n",
    "- Tests retrieval on sample geological queries\n",
    "- Evaluates chunk relevance\n",
    "- Shows retrieved evidence\n",
    "- Prepares for RAG pipeline testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "project_root = Path.cwd()\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "from src.config import Config\n",
    "from src.document_loader import DocumentLoader\n",
    "from src.chunker import Chunker\n",
    "from src.embeddings import EmbeddingGenerator\n",
    "from src.retriever import VectorRetriever\n",
    "from src.logger import get_logger\n",
    "\n",
    "logger = get_logger(__name__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Initialize pipeline\n",
    "config = Config()\n",
    "loader = DocumentLoader(config.reports_dir)\n",
    "documents = loader.load_all()\n",
    "\n",
    "chunker = Chunker()\n",
    "chunks = chunker.chunk_documents(documents)\n",
    "\n",
    "embedding_gen = EmbeddingGenerator(config)\n",
    "embeddings = embedding_gen.embed_chunks(chunks, cache_path=config.embeddings_cache_path)\n",
    "\n",
    "retriever = VectorRetriever(chunks, embeddings, top_k=5)\n",
    "\n",
    "print(f\"Ready to test retrieval on {len(chunks)} chunks\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test query 1\n",
    "test_query_1 = \"What minerals are found in Nigeria?\"\n",
    "query_embedding_1 = embedding_gen._embed_query(test_query_1)\n",
    "results_1 = retriever.retrieve(query_embedding_1, top_k=3)\n",
    "\n",
    "print(f\"Query: {test_query_1}\")\n",
    "print(f\"Results:\\n\")\n",
    "for result in results_1:\n",
    "    print(f\"  Rank {result.rank}: Score={result.score:.4f}\")\n",
    "    print(f\"    File: {result.chunk.metadata['source_file']}\")\n",
    "    print(f\"    Text: {result.chunk.text[:150]}...\\n\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test query 2\n",
    "test_query_2 = \"Geochemical anomalies in geological formations\"\n",
    "query_embedding_2 = embedding_gen._embed_query(test_query_2)\n",
    "results_2 = retriever.retrieve(query_embedding_2, top_k=3)\n",
    "\n",
    "print(f\"Query: {test_query_2}\")\n",
    "print(f\"Results:\\n\")\n",
    "for result in results_2:\n",
    "    print(f\"  Rank {result.rank}: Score={result.score:.4f}\")\n",
    "    print(f\"    File: {result.chunk.metadata['source_file']}\")\n",
    "    print(f\"    Text: {result.chunk.text[:150]}...\\n\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Score distribution analysis\n",
    "import numpy as np\n",
    "\n",
    "all_scores = []\n",
    "for chunk in chunks[:100]:  # Sample analysis\n",
    "    chunk_embedding = embeddings[chunks.index(chunk)]\n",
    "    results = retriever.retrieve(chunk_embedding, top_k=1)\n",
    "    all_scores.append(results[0].score)\n",
    "\n",
    "print(\"\\n=== Score Distribution ===")\n",
    "print(f\"Mean similarity score: {np.mean(all_scores):.4f}\")\n",
    "print(f\"Std dev: {np.std(all_scores):.4f}\")\n",
    "print(f\"Min: {np.min(all_scores):.4f}\")\n",
    "print(f\"Max: {np.max(all_scores):.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Next steps\n",
    "print(\"\\n=== Next Steps ===")\n",
    "print(\"1. Run notebook 04_rag_evaluation.ipynb to test full RAG pipeline\")\n",
    "print(\"2. Test answer generation with grounding\")\n",
    "print(\"3. Evaluate source citations\")"
   ]
  }
